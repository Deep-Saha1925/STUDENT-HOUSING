# Copy this file to `.env` and fill in real values.
# `.env` is gitignored (see .gitignore's `*.env` rule) — never commit real secrets.

# --- Database (Postgres) ---
# Get this connection string from your Neon dashboard (or any Postgres host).
DB_URL=jdbc:postgresql://your-host/your-db?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- Cloudinary (image uploads) ---
# From your Cloudinary dashboard: Settings -> Access Keys
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# --- Admin account seeding ---
# Used once on startup to create the admin@studenthousing.com account if it
# doesn't exist yet (see DataInitializer.java). Pick a real password here.
ADMIN_PASSWORD=change_me_to_a_strong_password
